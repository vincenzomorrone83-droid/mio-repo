---
---
<div class="sim">
  <div class="sim-controls">
    <label for="mb">Massa barionica M<sub>b</sub></label>
    <input id="mb" type="range" min="9" max="11.3" step="0.05" value="10.3" />
    <output id="mb-val" style="min-width: 8ch; text-align: right;"></output>
  </div>
  <canvas id="rot-canvas" width="900" height="420"></canvas>
  <div class="legend">
    <span><i class="swatch" style="background:#9a968a"></i> Solo Newton (barioni visibili)</span>
    <span><i class="swatch" style="background:#ff5a1f"></i> Previsione DVRT / MOND</span>
  </div>
  <p style="font-family: var(--mono); font-size: 0.75rem; color: var(--muted); margin-top: 0.8rem;">
    Grafico illustrativo (non un fit ai dati SPARC): mostra il comportamento qualitativo
    descritto nel paper — oltre il bordo del disco visibile, Newton predice un calo ∝ 1/√r,
    mentre DVRT predice una curva piatta a v<sub>c</sub> = (β·a₀·G·M<sub>b</sub>)<sup>1/4</sup> (Eq. 39).
  </p>
</div>

<script>
  const G = 6.674e-11;
  const A0 = 1.135e-10;
  const BETA = 1 / 6;
  const MSUN = 1.989e30;
  const KPC = 3.0857e19;

  const canvas = document.getElementById("rot-canvas") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;
  const slider = document.getElementById("mb") as HTMLInputElement;
  const out = document.getElementById("mb-val")!;

  const R_MAX_KPC = 30;
  const R_PEAK_KPC = 3.2;

  function vFlatKms(mbKg: number) {
    const v = Math.pow(BETA * A0 * G * mbKg, 0.25);
    return v / 1000;
  }

  function newtonCurve(rKpc: number, vFlat: number) {
    if (rKpc <= R_PEAK_KPC) {
      return vFlat * 1.18 * (rKpc / R_PEAK_KPC);
    }
    const vPeak = vFlat * 1.18;
    return vPeak * Math.sqrt(R_PEAK_KPC / rKpc);
  }

  function dvrtCurve(rKpc: number, vFlat: number) {
    if (rKpc <= R_PEAK_KPC) {
      return vFlat * 1.18 * (rKpc / R_PEAK_KPC);
    }
    return vFlat;
  }

  function draw() {
    const logMb = parseFloat(slider.value);
    const mbKg = Math.pow(10, logMb) * MSUN;
    const vFlat = vFlatKms(mbKg);
    out.textContent = `10^${logMb.toFixed(2)} M☉`;

    const w = canvas.width, h = canvas.height;
    const padL = 60, padB = 40, padT = 20, padR = 20;
    const plotW = w - padL - padR, plotH = h - padT - padB;

    ctx.clearRect(0, 0, w, h);
    const bg = getComputedStyle(document.body).getPropertyValue("--bg").trim() || "#f3f1ea";
    const fg = getComputedStyle(document.body).getPropertyValue("--fg").trim() || "#111";
    ctx.fillStyle = bg;
    ctx.fillRect(0, 0, w, h);

    const vMax = Math.max(vFlat * 1.5, 40);

    // axes
    ctx.strokeStyle = fg;
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(padL, padT);
    ctx.lineTo(padL, h - padB);
    ctx.lineTo(w - padR, h - padB);
    ctx.stroke();

    ctx.fillStyle = fg;
    ctx.font = "12px ui-monospace, monospace";
    ctx.fillText("v (km/s)", 8, padT + 10);
    ctx.fillText("r (kpc)", w - padR - 50, h - 10);

    function toX(rKpc: number) { return padL + (rKpc / R_MAX_KPC) * plotW; }
    function toY(v: number) { return h - padB - (v / vMax) * plotH; }

    // gridlines
    ctx.strokeStyle = "rgba(128,128,128,0.25)";
    ctx.lineWidth = 1;
    for (let v = 0; v <= vMax; v += 50) {
      ctx.beginPath();
      ctx.moveTo(padL, toY(v));
      ctx.lineTo(w - padR, toY(v));
      ctx.stroke();
      ctx.fillStyle = fg;
      ctx.fillText(String(v), 8, toY(v) + 4);
    }

    function plot(fn: (r: number, vf: number) => number, color: string) {
      ctx.strokeStyle = color;
      ctx.lineWidth = 3;
      ctx.beginPath();
      for (let i = 0; i <= 200; i++) {
        const r = (i / 200) * R_MAX_KPC;
        const v = fn(r, vFlat);
        const x = toX(r), y = toY(v);
        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      }
      ctx.stroke();
    }

    plot(newtonCurve, "#9a968a");
    plot(dvrtCurve, "#ff5a1f");
  }

  slider.addEventListener("input", draw);
  window.addEventListener("resize", draw);
  draw();
</script>
